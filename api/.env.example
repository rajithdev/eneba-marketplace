APP_NAME="Eneba Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Address of the React app. Used for CORS and for deciding which requests are
# allowed to use the login session.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is required (not just preferred): search uses the pg_trgm
# extension and checkout uses SELECT ... FOR UPDATE SKIP LOCKED.
# "db" is the service name in docker-compose.yml.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=eneba
DB_USERNAME=eneba
DB_PASSWORD=eneba

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No background workers on the free tier, so jobs (if any) run inline.
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
